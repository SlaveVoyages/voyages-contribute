# Development settings for the application, copy to your local .env file.

# Database type: "sqlite" (default) or "mysql"
CONTRIB_DB_TYPE=sqlite

# SQLite settings (used when CONTRIB_DB_TYPE=sqlite)
CONTRIB_DB_PATH=contrib.db

# MySQL settings (used when CONTRIB_DB_TYPE=mysql)
# CONTRIB_DB_HOST=dotproductstaging-mysql.mysql.database.azure.com
# CONTRIB_DB_PORT=3306
# CONTRIB_DB_USER=mysql_admin
# CONTRIB_DB_PASSWORD=
# CONTRIB_DB_NAME=voyages_contribute
# CONTRIB_DB_SSL_CA=DigiCertGlobalRootG2.crt.pem
# CONTRIB_DB_SSL=true      # Set to "false" to disable SSL

NODE_ENV=development
MEDIA_UPLOAD_FOLDER=uploads

# Supabase auth (used by the backend JWT middleware and by tests/api.http)
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWKS_URL= # optional; defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=your-anon-key

# Credentials used by tests/api.http to obtain an access_token via the password grant.
# Keep these out of .env.develop in real use — set them only in your local .env.
SUPABASE_AUTH_EMAIL=user@example.com
SUPABASE_AUTH_PASSWORD=your-password
